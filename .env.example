# Banco (dono do schema: só migrations usam esta URL)
DATABASE_URL=postgresql://finflow_owner:finflow_owner@localhost:5432/finflow

# Banco (papel da aplicação, sem BYPASSRLS: a API usa esta URL)
DATABASE_URL_APP=postgresql://finflow_api:finflow_api@localhost:5432/finflow

REDIS_URL=redis://localhost:6379

# Segredos da API — gere com: openssl rand -base64 48
JWT_ACCESS_SECRET=
API_PORT=4000
API_CORS_ORIGIN=http://localhost:3000

# Web
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000

# Login com Google (Supabase Auth só confirma a identidade). Valores do painel do Supabase:
# URL do projeto e chave publicável (pública). API e Web usam as duas.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Web: liga o botão só depois de o provedor Google estar ativo no Supabase.
GOOGLE_LOGIN=
