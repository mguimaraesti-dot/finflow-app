{
  "name": "finflow",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:setup": "bash scripts/db-setup.sh",
    "db:migrate": "pnpm --filter @finflow/db migrate:deploy",
    "db:seed": "pnpm --filter @finflow/db seed"
  },
  "devDependencies": {
    "turbo": "2.11.13",
    "typescript": "5.9.3"
  }
}
