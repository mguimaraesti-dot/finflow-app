{
  "name": "@finflow/api",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --watch --env-file-if-exists=../../.env dist/main.js",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@finflow/db": "workspace:*",
    "@finflow/shared": "workspace:*",
    "@nestjs/common": "11.2.12",
    "@nestjs/core": "11.2.12",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.12",
    "@nestjs/throttler": "^6.8.0",
    "@node-rs/argon2": "2.0.2",
    "helmet": "^8.3.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "^7.8.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@swc/core": "^1.16.22",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.7",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.3.2",
    "typescript": "5.9.3",
    "unplugin-swc": "^1.6.0",
    "vitest": "3.2.7"
  }
}
